    <template id="dics_invoice_portal_page" inherit_id="account.portal_invoice_page">
    <xpath expr="//div[hasclass('o_portal_html_view')]" position="replace">

        <!-- Keep iframe in DOM and visible to print JS, hide it visually only -->
        <div class="o_portal_html_view dics-iframe-hidden">
      <iframe id="invoice_html"
              width="100%"
              height="100%"
              frameborder="0"
              scrolling="no"
              t-att-src="invoice.get_portal_url(report_type='html')"/>
    </div>

        <!-- Our custom layout shown on screen -->
        <div class="dics-custom-invoice-container d-print-none">
            <t t-call="dics_theme.portal_invoice_detail"/>
        </div>

    </xpath>
</template>

