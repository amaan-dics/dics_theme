                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ═══════════════════════════════════════════════
                         4. WHY DATAINTEGER
                    ════════════════════════════════════════════════ -->
                    <section class="dics-detail-section dics-detail-section--dark">
                        <div class="dics-container">
                            <div class="dics-detail-section-head dics-detail-section-head--center">
                                <span class="dics-detail-eyebrow">The DataInteger Edge</span>
                                <h2>Why Leading Enterprise Teams Choose Us</h2>
                                <p>We don't just configure native apps. We build deep custom Odoo extensions engineered for high scalability.</p>
