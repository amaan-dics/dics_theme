<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <template id="dics_industries" name="DataInteger Industries" key="dics_theme.dics_industries" website_id="dics_theme.dics_website">
        <t t-call="website.layout">
            <t t-set="additional_title">Industries &amp; Sector-Specific Odoo ERP Architecture — DataInteger</t>
            <div id="wrap" class="dics-home">
                <main class="dics-main">
                    <section class="dics-ind-hero">
                        <div class="dics-container">
                            <div class="dics-ind-hero__eyebrow">
                                <span class="dics-status-dot"/>
                                <span>Sector-Specific ERP Architecture • Odoo 17 / 18</span>
                            </div>
                            <h1 class="dics-ind-hero__h1">Odoo that understands your <span class="dics-red">industry</span>.</h1>
                            <p class="dics-ind-hero__lead">
                                We shape Odoo around the way your teams sell, deliver, build, care, and grow — not around
                                a generic template. Every sector has its own vocabulary, compliance requirements, and
                                operational rhythms. We configure Odoo to match them precisely.
                            </p>
                            <div class="dics-ind-hero__stats">
                                <div class="dics-ind-stat"><strong>6+</strong><span>Specialized Verticals</span></div>
                                <div class="dics-ind-stat"><strong>Zero</strong><span>Business Disruption</span></div>
                                <div class="dics-ind-stat"><strong>100%</strong><span>Native &amp; API Integrations</span></div>
                                <div class="dics-ind-stat"><strong>Multi-Gov</strong><span>Compliance &amp; Audit Ready</span></div>
                            </div>
                        </div>
                    </section>
                    <section class="dics-section dics-section-surface">
                        <div class="dics-container">
                            <div class="dics-ind-cards-head">
                                <div>
                                    <span class="dics-eyebrow">Sector Portfolios</span>
                                    <h2>Engineered for real operational realities.</h2>
                                </div>
                                <p>Click into any specialized vertical to review real data flows, technical capabilities, and proprietary custom apps.</p>
                            </div>
                            <div class="dics-ind-cards-grid">
                                <t t-foreach="industries.items()" t-as="item" t-key="item[0]">
                                    <t t-set="slug" t-value="item[0]"/>
                                    <t t-set="industry" t-value="item[1]"/>
                                    <article class="dics-ind-card">
                                        <div>
                                            <div class="dics-ind-card__top">
                                                <div class="dics-ind-card__icon"><span class="material-symbols-outlined" t-esc="industry['icon']"/></div>
                                                <span class="dics-ind-card__sector" t-esc="industry.get('sector_label', industry['title'])"/>
                                            </div>
                                            <h3 class="dics-ind-card__title" t-esc="industry['title']"/>
                                            <p class="dics-ind-card__summary" t-esc="industry['summary']"/>
                                            <div class="dics-ind-card__badges">
                                                <t t-foreach="industry.get('badges', [])" t-as="badge" t-key="badge_index">
                                                    <span t-esc="badge"/>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="dics-ind-card__footer">
                                            <div>
                                                <span class="dics-ind-card__metric-label" t-esc="industry.get('metric_label', 'Key Capability')"/>
                                                <span class="dics-ind-card__metric-value" t-esc="industry.get('metric_value', 'Custom ERP Architecture')"/>
                                            </div>
                                            <a t-attf-href="/industries/#{slug}" class="dics-ind-card__link">
                                                Explore Blueprint <span class="material-symbols-outlined">arrow_forward</span>
                                            </a>
                                        </div>
                                    </article>
                                </t>
                            </div>
                        </div>
                    </section>
                    <section class="dics-section dics-section-light">
                        <div class="dics-container">
                            <div class="dics-ind-approach">
                                <div class="dics-ind-approach__left">
                                    <span class="dics-eyebrow">Our Approach &amp; Philosophy</span>
                                    <h2>Generic ERP implementations fail. <span class="dics-red">Industry-fit ones don't.</span></h2>
                                    <p>Most Odoo projects run over budget and under-deliver because they start with module activation rather than operational architecture. A manufacturer and a healthcare clinic both require inventory management — but the workflows, approval chains, and compliance obligations look nothing alike.</p>
                                    <div class="dics-ind-guarantee">
                                        <span class="material-symbols-outlined">check_circle</span>
                                        <div>
                                            <strong>DataInteger Architecture Guarantee</strong>
                                            <p>We study how your sector actually operates before touching code. The result is a platform your operators adopt naturally, mirroring the way they think about the business.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="dics-ind-approach__right">
                                    <div class="dics-ind-compare dics-ind-compare--bad">
                                        <div class="dics-ind-compare__header">
                                            <div class="dics-ind-compare__label dics-ind-compare__label--bad">
                                                <span class="material-symbols-outlined">close</span>
                                                The Traditional Generic Approach
                                            </div>
                                            <span class="dics-ind-compare__pill dics-ind-compare__pill--bad">High Friction</span>
                                        </div>
                                        <ul>
                                            <li><span class="material-symbols-outlined">warning</span><span><strong>Module-First Mindset:</strong> Activating all out-of-the-box modules hoping business processes will magically conform.</span></li>
                                            <li><span class="material-symbols-outlined">warning</span><span><strong>Terminology Gap:</strong> Staff struggle with unaligned labels, causing resistance and internal friction.</span></li>
                                            <li><span class="material-symbols-outlined">warning</span><span><strong>Dead-code Bloat:</strong> Customizations patched indiscriminately, creating upgrade blockers during Odoo major updates.</span></li>
                                        </ul>
                                    </div>
                                    <div class="dics-ind-compare dics-ind-compare--good">
                                        <div class="dics-ind-compare__header">
                                            <div class="dics-ind-compare__label dics-ind-compare__label--good">
                                                <span class="material-symbols-outlined">verified</span>
                                                DataInteger's Sector-First Engineering
                                            </div>
                                            <span class="dics-ind-compare__pill dics-ind-compare__pill--good">100% Team Adoption</span>
                                        </div>
                                        <ul>
                                            <li><span class="material-symbols-outlined">check</span><span><strong>Workflow-First Mapping:</strong> Scoping authority limits, cycle times, compliance milestones, and API touchpoints first.</span></li>
                                            <li><span class="material-symbols-outlined">check</span><span><strong>Proprietary Micro-Modules:</strong> Clean OWL components and decoupled Python extensions that withstand future upgrades.</span></li>
                                            <li><span class="material-symbols-outlined">check</span><span><strong>High Operational Concurrency:</strong> Configured for enterprise scale with automated failover and optimised PostgreSQL schemas.</span></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="dics-section dics-section-surface">
                        <div class="dics-container">
                            <div class="dics-centered-heading mb-5">
                                <span class="dics-eyebrow">Architectural Coverage</span>
                                <h2>Which Odoo modules apply to your sector?</h2>
                                <p class="dics-section-lead mx-auto">Not every module belongs in every deployment. The matrix below details the native applications we configure for each vertical, paired with our proprietary specialised extensions.</p>
                            </div>
                            <div class="dics-ind-matrix">
                                <div class="dics-ind-matrix__scroll">
                                    <table class="dics-ind-matrix__table">
                                        <thead>
                                            <tr>
                                                <th>Industry Vertical</th>
                                                <th>Core Odoo Modules Configured</th>
                                                <th>Proprietary Custom Extensions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="dics-ind-matrix__industry"><span class="material-symbols-outlined">precision_manufacturing</span>Manufacturing</td>
                                                <td><div class="dics-ind-matrix__tags"><span>Manufacturing (MRP)</span><span>Inventory</span><span>Purchase</span><span>Quality</span><span>Accounting</span></div></td>
                                                <td><span class="dics-ind-matrix__ext"><span class="material-symbols-outlined">auto_awesome</span>Production scheduling matrix, quality gate automation, subcontracting flows</span></td>
                                            </tr>
                                            <tr>
                                                <td class="dics-ind-matrix__industry"><span class="material-symbols-outlined">local_shipping</span>Distribution &amp; Logistics</td>
                                                <td><div class="dics-ind-matrix__tags"><span>Inventory (WMS)</span><span>Purchase</span><span>Sales</span><span>Delivery/Fleet</span><span>Accounting</span></div></td>
                                                <td><span class="dics-ind-matrix__ext"><span class="material-symbols-outlined">auto_awesome</span>Carrier API integrations, dynamic route optimisation, B2B customer dispatch portal</span></td>
                                            </tr>
                                            <tr>
                                                <td class="dics-ind-matrix__industry"><span class="material-symbols-outlined">shopping_cart</span>Retail &amp; eCommerce</td>
                                                <td><div class="dics-ind-matrix__tags"><span>Point of Sale</span><span>eCommerce</span><span>Inventory</span><span>CRM</span><span>Accounting</span></div></td>
                                                <td><span class="dics-ind-matrix__ext"><span class="material-symbols-outlined">auto_awesome</span>Marketplace bi-directional sync, unified loyalty engines, automated returns hub</span></td>
                                            </tr>
                                            <tr>
                                                <td class="dics-ind-matrix__industry"><span class="material-symbols-outlined">health_and_safety</span>Healthcare &amp; Clinics</td>
                                                <td><div class="dics-ind-matrix__tags"><span>Appointments</span><span>Inventory</span><span>Invoicing</span><span>HR</span><span>Purchase</span></div></td>
                                                <td><span class="dics-ind-matrix__ext"><span class="material-symbols-outlined">auto_awesome</span>Patient health record vault, e-prescription tracking, insurance claim reconciliation</span></td>
                                            </tr>
                                            <tr>
                                                <td class="dics-ind-matrix__industry"><span class="material-symbols-outlined">engineering</span>Construction &amp; Projects</td>
                                                <td><div class="dics-ind-matrix__tags"><span>Project</span><span>Timesheets</span><span>Purchase</span><span>Field Service</span><span>Accounting</span></div></td>
                                                <td><span class="dics-ind-matrix__ext"><span class="material-symbols-outlined">auto_awesome</span>BOQ manager, site progress measurement, subcontractor certification</span></td>
                                            </tr>
                                            <tr>
                                                <td class="dics-ind-matrix__industry"><span class="material-symbols-outlined">account_balance</span>Professional Services</td>
                                                <td><div class="dics-ind-matrix__tags"><span>CRM</span><span>Project</span><span>Timesheets</span><span>Invoicing</span><span>HR/Payroll</span></div></td>
                                                <td><span class="dics-ind-matrix__ext"><span class="material-symbols-outlined">auto_awesome</span>Milestone retainer billing, dynamic resource capacity planning, client transparency portal</span></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="dics-ind-matrix__footer">
                                    <span>This is an indicative architecture baseline. Modules and custom delta are scoped during Discovery.</span>
                                    <span>Native Odoo 17/18 Community &amp; Enterprise Supported</span>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="dics-section dics-section-light">
                        <div class="dics-container">
                            <div class="dics-ind-process">
                                <div class="dics-ind-process__left">
                                    <span class="dics-eyebrow">How We Work</span>
                                    <h2>The same disciplined process, shaped to your sector.</h2>
                                    <p>Every industry engagement follows four rigorous engineering stages. What changes is the vocabulary, the module selection, and the depth of customisation your sector demands.</p>
                                    <ul class="dics-ind-process__bullets">
                                        <li><span class="dics-ind-process__dot"/><span>Zero guesswork roadmaps</span></li>
                                        <li><span class="dics-ind-process__dot"/><span>Weekly sandbox demo iterations</span></li>
                                        <li><span class="dics-ind-process__dot"/><span>Automated regression testing suite</span></li>
                                    </ul>
                                </div>
                                <div class="dics-ind-process__steps">
                                    <div class="dics-ind-step">
                                        <span class="dics-ind-step__num">01</span>
                                        <div>
                                            <div class="dics-ind-step__title-row"><h3>Sector Discovery &amp; Gap Analysis</h3><span class="dics-ind-step__tag">Milestone 1</span></div>
                                            <p>We map your industry-specific workflows — production cycles, regulatory checkpoints, subcontractor sign-offs, and customer billing patterns — before a single module is touched.</p>
                                        </div>
                                    </div>
                                    <div class="dics-ind-step">
                                        <span class="dics-ind-step__num">02</span>
                                        <div>
                                            <div class="dics-ind-step__title-row"><h3>Architecture, Scoping &amp; Data Schema</h3><span class="dics-ind-step__tag">Milestone 2</span></div>
                                            <p>We define which modules to implement, in which order, and what custom development is genuinely needed. You receive a written scope with technical architecture diagrams, timeline, and cost.</p>
                                        </div>
                                    </div>
                                    <div class="dics-ind-step">
                                        <span class="dics-ind-step__num">03</span>
                                        <div>
                                            <div class="dics-ind-step__title-row"><h3>Build, Configure, Test &amp; Live Dry-Runs</h3><span class="dics-ind-step__tag">Milestone 3</span></div>
                                            <p>Configuration and custom modules are delivered in working increments. You test against real scenarios from your operation throughout — not just at the end in an artificial test bed.</p>
                                        </div>
                                    </div>
                                    <div class="dics-ind-step">
                                        <span class="dics-ind-step__num">04</span>
                                        <div>
                                            <div class="dics-ind-step__title-row"><h3>Go-Live, Transition &amp; Long-Term Support</h3><span class="dics-ind-step__tag dics-ind-step__tag--green">Production</span></div>
                                            <p>A structured cutover, hands-on team training, and an SLA-backed support arrangement that grows with you — version upgrades, performance tuning, and new modules as you expand.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="dics-detail-section  dics-ind-cta">
                        <div class="dics-container dics-ind-cta__inner">
                            <span class="dics-detail-eyebrow"><span class="material-symbols-outlined">terminal</span>A Practical Starting Point</span>
                            <h2>Your processes are the blueprint.</h2>
                            <p>Tell us where information gets stuck today. We will map the workflows, data pipelines, and Odoo applications that can move your business forward.</p>
                            <div class="dics-ind-cta__actions">
                                <a href="/contact" class="dics-btn dics-btn-primary">Schedule Sector Architecture Session <span class="material-symbols-outlined">arrow_forward</span></a>
                                <a href="/contact" class="dics-btn dics-btn-secondary">Contact Us</a>
                            </div>
                            <div class="dics-ind-cta__proof">
                                <span><span class="material-symbols-outlined">check</span> No generic sales demo</span>
                                <span><span class="material-symbols-outlined">check</span> Direct consultation with Lead ERP Architect</span>
                            </div>
                        </div>
                    </section>
                </main>
            </div>
        </t>
    </template>

    <!-- ================================================================
         INDUSTRY DETAIL — REBUILT
    ================================================================ -->
    <template id="dics_industry_detail" name="DataInteger Industry Detail" key="dics_theme.dics_industry_detail" website_id="dics_theme.dics_website">
        <t t-call="website.layout">
            <t t-set="additional_title"><t t-esc="industry.get('title', 'Industry Solution')"/> Odoo ERP Solutions — DataInteger</t>
            <div id="wrap" class="dics-home">
                <main class="dics-main">

                    <!-- ═══════════════════════════════════════════════
                         1. HERO
                    ════════════════════════════════════════════════ -->
                    <section class="dics-hero">
                        <div class="dics-container">
                            <div class="dics-hero-grid">
                                <div class="dics-hero-copy">
                                    <div class="dics-eyebrow-pill">
                                        <span class="dics-status-dot"/>
                                        <span t-esc="industry.get('subtitle', 'Odoo Industry ERP Solutions')"/>
                                    </div>
                                    <h1>Transform Your Operations with <span class="dics-red">Tailored Odoo</span> Solutions</h1>
                                    <p class="dics-hero-lead" t-esc="industry.get('hero_description', 'Streamline supply chains, multi-warehouse sync, real-time inventory tracking, and logistics automation with a custom-engineered Odoo architecture.')"/>
                                    <div class="dics-actions">
                                        <a href="/contactus" class="dics-btn dics-btn-primary">Schedule Consultation <span class="dics-arrow">→</span></a>
                                        <a href="#solutions" class="dics-btn dics-btn-secondary">Explore Features</a>
                                    </div>
                                    <div class="dics-proof">
                                        <span><b>100%</b> Architecture Alignment</span>
                                        <span>•</span>
                                        <span><b>Zero</b> Operational Downtime</span>
                                    </div>
                                </div>
                                <div class="dics-console">
                                    <div class="dics-console-header">
                                        <div class="dics-console-title">
                                            <span class="dics-console-dot dics-console-dot-red"/>
                                            <span>SYSTEM MONITOR // LIVE ENGINE</span>
                                        </div>
                                        <div class="dics-sync"><span/> OPTIMIZED</div>
                                    </div>
                                    <div class="dics-console-nodes">
                                        <div class="dics-system-node">
                                            <div class="dics-node-icon dics-node-red"><span class="material-symbols-outlined">hub</span></div>
                                            <div class="dics-node-info"><strong>Multi-Warehouse Routing</strong><small>Auto Stock Allocation &amp; Transfer</small></div>
                                            <span class="dics-node-state">ACTIVE</span>
                                        </div>
                                        <div class="dics-system-node dics-node-offset">
                                            <div class="dics-node-icon"><span class="material-symbols-outlined">inventory_2</span></div>
                                            <div class="dics-node-info"><strong>WMS &amp; 3PL Integration</strong><small>Barcode &amp; Automated Picking</small></div>
                                            <span class="dics-node-metric">99.9% Sync</span>
                                        </div>
                                        <div class="dics-system-node dics-node-offset-right">
                                            <div class="dics-node-icon dics-node-red"><span class="material-symbols-outlined">local_shipping</span></div>
                                            <div class="dics-node-info"><strong>Fleet &amp; Dispatch Tracking</strong><small>Carrier API &amp; Route Dispatch</small></div>
                                            <span class="dics-node-state">ONLINE</span>
                                        </div>
                                    </div>
                                    <div class="dics-console-footer">
                                        <span>ARCH: <strong>ODOO 18 ENTERPRISE</strong></span>
                                        <span>DEPLOY: <strong>CUSTOM MODULES</strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ═══════════════════════════════════════════════
                         2. CHALLENGES
                    ════════════════════════════════════════════════ -->
                    <section class="dics-section dics-section-surface">
                        <div class="dics-container">
                            <div class="dics-centered-heading mb-5">
                                <span class="dics-eyebrow">Industry Friction Points</span>
                                <h2>Key Operational Challenges We Eliminate</h2>
                                <p>Standard ERP systems force companies into rigid workflows. We solve the core bottlenecks specific to your sector.</p>
                            </div>
                            <div class="dics-detail-capability-grid">
                                <div class="dics-detail-capability-card">
                                    <div class="dics-detail-card-icon"><span class="material-symbols-outlined">warning</span></div>
                                    <h3>Stock Discrepancy &amp; Leakage</h3>
                                    <p>Manual stock logs across multi-warehouse environments cause delay, fulfillment errors, and inflated inventory holding costs.</p>
                                </div>
                                <div class="dics-detail-capability-card">
                                    <div class="dics-detail-card-icon"><span class="material-symbols-outlined">alt_route</span></div>
                                    <h3>Fragmented Carrier Systems</h3>
                                    <p>Lack of direct API integration between 3PL platforms, order processing hubs, and regional shipping dispatchers.</p>
                                </div>
                                <div class="dics-detail-capability-card">
                                    <div class="dics-detail-card-icon"><span class="material-symbols-outlined">receipt_long</span></div>
                                    <h3>Inaccurate Batch &amp; Lot Billing</h3>
                                    <p>Difficulty in matching exact lot picking data with custom client pricing tables, invoices, and delivery notes.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ═══════════════════════════════════════════════
                         3. MODULE CAPABILITIES
                    ════════════════════════════════════════════════ -->
