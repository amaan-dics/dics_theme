                    </section>

                    <!-- ═══════════════════════════════════════════════
                         5. TECHNICAL INSIGHTS  ← NEW
                    ════════════════════════════════════════════════ -->
                    <section class="dics-ind-detail-insights">
                        <div class="dics-container">
                            <div class="dics-ind-detail-insights__head">
                                <div>
                                    <span class="dics-eyebrow">Field Intelligence &amp; Perspectives</span>
