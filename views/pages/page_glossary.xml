                                        <div class="col-12 col-md-6">
                                            <article class="card dics-glossary-card h-100 shadow" data-category="manufacturing">
                                                <div class="dics-glossary-card-row">
                                                    <div class="dics-capability-name"><h3>Bill of Materials (BOM)</h3></div>
