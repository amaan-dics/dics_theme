                                        <div class="col-12 col-md-6">
                                            <article class="card dics-glossary-card h-100 shadow" data-category="framework ui">
                                                <div class="dics-glossary-card-row">
                                                    <div class="dics-capability-name"><h3>Action</h3></div>
                                                    <div class="dics-capability-meta"><small>ir.actions.* • Window / Server / Report</small></div>
                                                </div>
                                                <div class="dics-capability-content">
                                                    <div class="dics-capability-inner">
                                                        <p>
                                                            An operation triggered by a menu click, button, or system event in Odoo.
                                                            Types include Window Actions (<code>ir.actions.act_window</code>),
                                                            Server Actions (<code>ir.actions.server</code>), and
                                                            Report Actions (<code>ir.actions.report</code>).
                                                        </p>
                                                        <div class="dics-tags">
                                                            <span>Framework</span>
                                                            <span>UI</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </article>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <article class="card dics-glossary-card h-100 shadow" data-category="automation backend">
                                                <div class="dics-glossary-card-row">
                                                    <div class="dics-capability-name"><h3>Automated Action</h3></div>
                                                    <div class="dics-capability-meta"><small>base.automation • Trigger Rules</small></div>
                                                </div>
                                                <div class="dics-capability-content">
                                                    <div class="dics-capability-inner">
                                                        <p>
                                                            Configurable event triggers executed on record creation, updates, or timed
                                                            intervals to automate emails, field updates, or custom Python scripts
                                                            without writing custom modules.
                                                        </p>
                                                        <div class="dics-tags">
                                                            <span>Automation</span>
                                                            <span>Backend</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </article>
                                        </div>

                                    </div>
                                </div>

