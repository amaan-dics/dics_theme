<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="dics_service_text" model="ir.ui.view">
        <field name="name">DataInteger: service text block</field>
        <field name="type">qweb</field>
        <field name="key">dics_theme.dics_service_text</field>
        <field name="website_id" ref="dics_theme.dics_website"/>
        <field name="arch" type="xml">
            <t t-name="dics_theme.dics_service_text">
                <t t-if="extra_class is undefined" t-set="extra_class" t-value="''"/>
                <div t-attf-class="dics-svc-text #{extra_class}">

                    <span class="dics-svc-text__eyebrow" t-esc="svc['subtitle']"/>
                    <h2 t-esc="svc['title']"/>
                    <p class="dics-svc-text__desc" t-esc="svc['description']"/>

                    <div class="dics-svc-text__features">
                        <t t-foreach="svc['features']" t-as="feature" t-key="feature_index">
                            <div class="dics-svc-text__feature">
                                <span class="dics-svc-text__feature-icon">✓</span>
                                <span t-esc="feature"/>
                            </div>
                        </t>
                    </div>

                    <div class="dics-svc-text__actions" style="display: flex; align-items: center; gap: 1.5rem; margin-top: 1.5rem;">
                        <a t-if="svc.get('url')" t-att-href="svc['url']" class="dics-btn dics-btn-secondary">
                            Read More
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a href="/contact" class="dics-btn dics-btn-primary">
                            Discuss this service →
                        </a>
                    </div>

                </div>
            </t>
        </field>
    </record>




    <record id="dics_services" model="ir.ui.view">
        <field name="name">DataInteger Services</field>
        <field name="type">qweb</field>
        <field name="key">dics_theme.dics_services</field>
        <field name="website_id" ref="dics_theme.dics_website"/>
        <field name="arch" type="xml">
            <t t-name="dics_theme.dics_services">
                <t t-call="website.layout">

                    <t t-set="additional_title">Services — DataInteger Consultancy</t>
                    <t t-set="all_services" t-value="[
                        {
                            'id': 'odoo-erp',
                            'url': '/services/odoo-erp',
                            'icon': '▤',
                            'title': 'Odoo ERP Implementation',
                            'subtitle': 'Unify your operations',
                            'description': 'End the nightmare of disconnected systems. We implement, customize, and maintain Odoo to bring sales, inventory, accounting, and HR under one intelligent roof.',
                            'features': ['Full ERP Implementation', 'Module Customization', 'Data Migration', 'Staff Training &amp; SLA'],
                        },
                        {
                            'id': 'custom-dev',
                            'url': '/services/odoo-erp#custom-dev',
                            'icon': '⌘',
                            'title': 'Custom Module Development',
                            'subtitle': 'Precision-engineered for your workflow',
                            'description': 'When standard Odoo modules fall short, we build proprietary business logic, custom view models, OWL components, and domain-specific calculation engines.',
                            'features': ['Custom ORM Models', 'OWL Components', 'Server Actions', 'Automated Reports'],
                        },
                        {
                            'id': 'integration',
                            'url': '/services/custom-software',
                            'icon': '↗',
                            'title': 'System Integration',
                            'subtitle': 'Connect everything',
                            'description': 'We build REST, webhook, XML-RPC, eCommerce, payment, logistics, and custom middleware integrations that keep your entire stack in sync without manual intervention.',
                            'features': ['REST &amp; XML-RPC APIs', 'Webhook Pipelines', 'Courier Connectors', 'Payment Gateways'],
                        },
                        {
                            'id': 'migration',
                            'url': '/odoo-migration',
                            'icon': '◎',
                            'title': 'ERP Migration',
                            'subtitle': 'Safe, zero-downtime cutovers',
                            'description': 'Migration work includes data transformation, deprecated API refactoring, reconciliation, automated testing, and controlled production cutover — no data left behind.',
                            'features': ['Version Upgrades', 'Data Transformation', 'Legacy Decommission', 'Production Cutover'],
                        },
                        {
                            'id': 'custom-software',
                            'url': '/services/web-mobile',
                            'icon': '▦',
                            'title': 'Custom Software &amp; Mobile',
                            'subtitle': 'Beyond ERP',
                            'description': 'Bespoke companion mobile applications, customer portals, warehouse barcode systems, and offline-first applications for workflows that extend beyond standard ERP.',
                            'features': ['Android / Barcode SDK', 'Client Portals', 'Offline Queuing', 'Cloud SaaS'],
                        },
                        {
                            'id': 'support',
                            'url': '/services/odoo-erp#support',
                            'icon': '◇',
                            'title': 'Support &amp; Evolution',
                            'subtitle': 'SLA-backed, long-term',
                            'description': 'Continuous SLA-backed technical assistance, performance reviews, Odoo version upgrades, team training sessions, and ongoing feature expansion as your business grows.',
                            'features': ['SLA Response Guarantee', 'Performance Audits', 'Odoo Upgrades', 'Team Training'],
                        },
                    ]"/>
                    <div id="wrap" class="dics-services-page">
                        <div id="scrollProgress" class="dics-scroll-progress" aria-hidden="true"/>
                        <section class="dics-svc-hero">
                            <div class="dics-svc-hero__glow"/>
                            <div class="dics-svc-hero__dotgrid"/>
                            <div class="dics-container">
                                <div class="dics-svc-hero__content dics-reveal">
                                    <div class="dics-eyebrow-pill">
                                        <span class="dics-status-dot"/>
                                        <span>Engineering Capabilities</span>
                                    </div>
                                    <h1>
                                        We solve the
                                        <span class="dics-red">hard problems.</span>
                                    </h1>
                                    <p>
                                        Our engineering team delivers Odoo ERP, custom software,
                                        and integration solutions that impact your bottom line —
                                        not just your inbox.
                                    </p>
                                </div>
                            </div>
                        </section>

                        <section class="dics-svc-list">
                            <div class="dics-container">
                                <t t-foreach="all_services" t-as="svc" t-key="svc_index">
                                    <div class="dics-svc-scroll"
                                         t-attf-id="#{svc['id']}"
                                         t-att-data-index="svc_index">
                                        <div class="dics-svc-scroll__sticky">
                                            <div t-attf-class="dics-svc-scroll__row #{'is-reverse' if svc_index % 2 else ''}">

                                                <div class="dics-svc-scroll__visual">
                                                    <div class="dics-svc-scroll__glow"/>
                                                    <div class="dics-svc-scroll__dotgrid"/>

                                                    <div class="dics-svc-scroll__icon-bg">
                                                        <span t-esc="svc['icon']"/>
                                                    </div>
                                                    <div t-attf-class="dics-svc-scroll__badge #{'is-reverse' if svc_index % 2 else ''}">
                                                        <span t-esc="svc['icon']"/>
                                                    </div>
                                                    <div t-attf-class="dics-svc-scroll__overlay #{'is-reverse' if svc_index % 2 else ''}">
                                                        <div class="dics-svc-scroll__overlay-content">
                                                            <span class="dics-svc-scroll__overlay-eyebrow" t-esc="svc['subtitle']"/>
                                                            <h2 t-esc="svc['title']"/>
                                                            <p t-esc="svc['description']"/>

                                                            <div class="dics-svc-scroll__actions" style="display: flex; align-items: center; gap: 1.5rem; margin-top: 1.5rem;">
                                                                <a t-if="svc.get('url')" t-att-href="svc['url']" class="dics-btn dics-btn-secondary">
                                                                    Read More
                                                                    <span class="material-symbols-outlined">arrow_forward</span>
                                                                </a>
                                                                <a href="/contact" class="dics-btn dics-btn-red dics-svc-overlay-cta">
                                                                    Discuss this service →
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="dics-svc-scroll__text-wrap">
                                                    <t t-call="dics_theme.dics_service_text"/>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="dics-svc-mobile dics-reveal">
                                        <div class="dics-svc-mobile__visual">
                                            <div class="dics-svc-mobile__icon-bg">
                                                <span t-esc="svc['icon']"/>
                                            </div>
                                            <div class="dics-svc-mobile__badge">
                                                <span t-esc="svc['icon']"/>
                                            </div>
                                        </div>
                                        <t t-call="dics_theme.dics_service_text">
                                            <t t-set="extra_class">dics-svc-text--mobile</t>
                                        </t>
                                    </div>

                                </t>
                            </div>
                        </section>
                        <section class="dics-svc-cta-section mx-auto w-75">
                            <div class="dics-container">
                                <div class="dics-svc-cta-card dics-reveal">
                                    <div class="dics-svc-cta-card__glow dics-svc-cta-card__glow--1"/>
                                    <div class="dics-svc-cta-card__glow dics-svc-cta-card__glow--2"/>
                                    <div class="dics-svc-cta-card__ring"/>
                                    <div class="dics-svc-cta-card__content">
                                        <h2>Not sure what you need?</h2>
                                        <p>
                                            We offer a free technical consultation to audit your
                                            current setup and propose a clear roadmap.
                                        </p>
                                        <a href="/contact" class="dics-btn dics-btn-secondary dics-svc-cta-card__btn">
                                            Book a Consultation →
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>

                </t>
            </t>
        </field>
    </record>

</odoo>