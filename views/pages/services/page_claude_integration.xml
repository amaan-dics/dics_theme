                <!-- ═══════════════════════════════════════════
                     WHAT WE ACTUALLY BUILT
                ═══════════════════════════════════════════ -->
                <section class="dics-cl-section dics-cl-section--light">
                    <div class="dics-container">
                        <div class="dics-cl-section-head dics-cl-section-head--center">
                            <span class="dics-cl-eyebrow">What We Built</span>
                            <h2>Full automation, end to end.<br/>Not a pilot. Not a demo.
                            </h2>
                            <p>
                                Every step in this list runs without a human in the loop —
                                Claude reads Odoo's live data, reasons about it,
                                and takes action directly inside the ERP.
                            </p>
                        </div>

                        <div class="dics-cl-pipeline">

                            <!-- Step 01 -->
                            <div class="dics-cl-pipeline__item">
                                <div class="dics-cl-pipeline__node">
                                    <span class="dics-cl-pipeline__number">01</span>
                                    <div class="dics-cl-pipeline__line"/>
                                </div>
                                <div class="dics-cl-pipeline__card">
                                    <div class="dics-cl-pipeline__meta">
                                        <span class="dics-cl-pipeline__badge">
                                            <span class="material-symbols-outlined">database</span>
                                            Real-time Sync
                                        </span>
                                    </div>
                                    <h3>Claude reads live Odoo data</h3>
                                    <p>Sales orders, stock levels, vendor records, accounting entries — Claude has read
                                        access to your real-time relational database, not a stale export.
                                    </p>
                                </div>
                            </div>

                            <!-- Step 02 -->
                            <div class="dics-cl-pipeline__item">
                                <div class="dics-cl-pipeline__node">
                                    <span class="dics-cl-pipeline__number">02</span>
                                    <div class="dics-cl-pipeline__line"/>
                                </div>
                                <div class="dics-cl-pipeline__card">
                                    <div class="dics-cl-pipeline__meta">
                                        <span class="dics-cl-pipeline__badge">
                                            <span class="material-symbols-outlined">psychology</span>
                                            Operational Logic
                                        </span>
                                    </div>
                                    <h3>It reasons about the context</h3>
                                    <p>Claude understands business rules, approval thresholds, vendor preferences, and
                                        inventory logic — it doesn't just execute instructions, it understands intent.
                                    </p>
                                </div>
                            </div>

                            <!-- Step 03 -->
                            <div class="dics-cl-pipeline__item">
                                <div class="dics-cl-pipeline__node">
                                    <span class="dics-cl-pipeline__number">03</span>
                                    <div class="dics-cl-pipeline__line"/>
                                </div>
                                <div class="dics-cl-pipeline__card">
                                    <div class="dics-cl-pipeline__meta">
                                        <span class="dics-cl-pipeline__badge">
                                            <span class="material-symbols-outlined">bolt</span>
                                            Native Execution
                                        </span>
                                    </div>
                                    <h3>It drafts, creates, and executes</h3>
                                    <p>Quotations written. Purchase orders raised. Emails drafted. Invoices posted.
                                        Journal entries created. All initiated by Claude through Odoo's native ORM — no
                                        brittle API hacks.
                                    </p>
                                </div>
                            </div>

                            <!-- Step 04 -->
                            <div class="dics-cl-pipeline__item">
                                <div class="dics-cl-pipeline__node">
                                    <span class="dics-cl-pipeline__number">04</span>
                                    <div class="dics-cl-pipeline__line"/>
                                </div>
                                <div class="dics-cl-pipeline__card">
                                    <div class="dics-cl-pipeline__meta">
                                        <span class="dics-cl-pipeline__badge dics-cl-pipeline__badge--accent">
                                            <span class="material-symbols-outlined">verified_user</span>
                                            Human Guardrail
                                        </span>
                                    </div>
                                    <h3>Human validates at critical junctions</h3>
                                    <p>For high-stakes actions, Claude surfaces a clear summary and waits for a single
                                        confirmation tap. The human stays accountable — Claude handles the work.
                                    </p>
                                </div>
                            </div>

                            <!-- Step 05 -->
                            <div class="dics-cl-pipeline__item">
                                <div class="dics-cl-pipeline__node">
                                    <span class="dics-cl-pipeline__number">05</span>
                                </div>
                                <div class="dics-cl-pipeline__card">
                                    <div class="dics-cl-pipeline__meta">
                                        <span class="dics-cl-pipeline__badge">
                                            <span class="material-symbols-outlined">history</span>
                                            Governance &amp; Audit
                                        </span>
                                    </div>
                                    <h3>Full audit trail in Odoo</h3>
                                    <p>Every Claude-initiated action is logged with context, reasoning, and timestamp
                                        inside Odoo's chatter — fully traceable, fully auditable, fully compliant.
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ═══════════════════════════════════════════
                     AUTOMATION CAPABILITIES
                ═══════════════════════════════════════════ -->
                <section class="dics-cl-section">
                    <div class="dics-container">
                        <div class="dics-cl-section-head">
                            <span class="dics-cl-eyebrow">Automation Capabilities</span>
                            <h2>What Claude automates<br/>inside your Odoo.
                            </h2>
                            <p>Across every major module, Claude handles the work that used to sit in someone's task
                                list.
                            </p>
                        </div>

                        <div class="dics-cl-caps-grid">

                            <article class="dics-cl-cap-card">
                                <div class="dics-cl-cap-card__icon">
                                    <span class="material-symbols-outlined">receipt_long</span>
                                </div>
                                <h3>Sales &amp; Quotations</h3>
                                <ul>
                                    <li>Drafts quotations from email or voice brief</li>
                                    <li>Applies pricing rules and discount logic</li>
                                    <li>Sends to customer portal for e-signature</li>
                                    <li>Converts confirmed quotes to sales orders</li>
                                </ul>
                            </article>

                            <article class="dics-cl-cap-card">
                                <div class="dics-cl-cap-card__icon">
                                    <span class="material-symbols-outlined">inventory_2</span>
                                </div>
                                <h3>Inventory &amp; Procurement</h3>
                                <ul>
                                    <li>Monitors reorder points in real time</li>
                                    <li>Raises RFQs to preferred vendors automatically</li>
                                    <li>Validates incoming receipts against PO</li>
                                    <li>Updates lot tracking and storage locations</li>
                                </ul>
                            </article>

                            <article class="dics-cl-cap-card">
                                <div class="dics-cl-cap-card__icon">
                                    <span class="material-symbols-outlined">account_balance</span>
                                </div>
                                <h3>Accounting &amp; Finance</h3>
                                <ul>
                                    <li>Posts journal entries from summaries</li>
                                    <li>Reconciles bank statements automatically</li>
                                    <li>Drafts customer invoices from delivery</li>
                                    <li>Flags overdue receivables with context</li>
                                </ul>
                            </article>

                            <article class="dics-cl-cap-card">
                                <div class="dics-cl-cap-card__icon">
                                    <span class="material-symbols-outlined">support_agent</span>
                                </div>
                                <h3>CRM &amp; Customer Ops</h3>
                                <ul>
                                    <li>Qualifies inbound leads from email</li>
                                    <li>Schedules follow-up tasks in pipeline</li>
                                    <li>Drafts personalised outreach emails</li>
                                    <li>Logs call summaries to CRM records</li>
                                </ul>
                            </article>

                            <article class="dics-cl-cap-card">
                                <div class="dics-cl-cap-card__icon">
                                    <span class="material-symbols-outlined">precision_manufacturing</span>
                                </div>
                                <h3>Manufacturing</h3>
                                <ul>
                                    <li>Creates work orders from sales demand</li>
                                    <li>Checks component availability before scheduling</li>
                                    <li>Flags production delays with root cause</li>
                                    <li>Updates BOM consumption on completion</li>
                                </ul>
                            </article>

                            <article class="dics-cl-cap-card">
                                <div class="dics-cl-cap-card__icon">
                                    <span class="material-symbols-outlined">description</span>
                                </div>
                                <h3>Documents &amp; Reporting</h3>
                                <ul>
                                    <li>Generates board-ready summary reports</li>
                                    <li>Extracts data from uploaded PDFs into records</li>
                                    <li>Translates reports into plain-English summaries</li>
                                    <li>Schedules and distributes reports automatically</li>
                                </ul>
                            </article>

                        </div>
                    </div>
