                                                       required="required"/>
                                            </label>
                                        </div>
                                        <div class="dics-form-grid">
                                            <label>
                                                <span>Business Email *</span>
                                                <input type="email" name="email" placeholder="alex@acme.com"
                                                       required="required"/>
                                            </label>
                                            <label>
                                                <span>Phone / WhatsApp</span>
                                                <input type="tel" name="phone" placeholder="+91 98765 43210"/>
                                            </label>
                                        </div>
                                        <label>
                                            <span>Describe What Needs to Connect *</span>
                                            <textarea name="message" rows="4"
                                                      placeholder="Which systems, direction of sync, approximate data volumes..."
                                                      required="required"/>
                                        </label>
                                        <button type="submit" class="dics-btn dics-btn-primary dics-submit">
                                            <span>Submit Inquiry</span>
                                            <span>→</span>
                                        </button>
                                        <p class="dics-form-status" hidden="hidden"/>
                                    </form>
                                </div>
                            </section>

                        </main>
                    </div>
                </t>
            </t>
        </field>
