<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="page_404"
                  name="404 Page"
                  key="dics_theme.page_404"
                  website_id="dics_theme.dics_website">

            <t t-call="website.layout">

                <div id="wrap" class="oe_structure dics-404-page">

                    <section class="dics-404">
                        <div class="dics-container">

                            <div class="dics-404__content">

                                <div class="dics-404__number">
                                    404
                                </div>

                                <h1 class="dics-404__title">
                                    Oops! Page Not Found
                                </h1>

                                <p class="dics-404__text">
                                    The page you're looking for doesn't exist or has been moved.
                                </p>

                                <div class="dics-404__actions">

                                    <a href="/" class="dics-404__btn dics-404__btn--primary">
                                        <span class="material-symbols-outlined">home</span>
                                        <span>Go Home</span>
                                    </a>

                                    <a href="/services" class="dics-404__btn dics-404__btn--secondary">
                                        <span>Explore Services</span>
                                        <span class="material-symbols-outlined">arrow_forward</span>
                                    </a>

                                </div>

                            </div>

                        </div>
                    </section>

                </div>

            </t>
        </template>
    </data>
</odoo>