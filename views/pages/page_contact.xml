<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="dics_contact" name="Datainteger Consultancy Services Contact Page" key="dics_theme.dics_contact" website_id="dics_theme.dics_website">
        <t t-call="website.layout">

            <div id="wrap" class="dics-website-page">
                <div id="top-contact" class="dics-contact-page">
                    <div class="container">

                        <div class="contact-hero">
                            <h1>Let's Talk.</h1>
                            <p>Have a project in mind? We'd love to hear about it. Fill out
                                the form below, and one of our senior partners will get back to you within 24 hours.
                            </p>
                        </div>

                        <div class="contact-layout">

                            <!-- Left: map + office details -->
                            <div class="contact-sidebar">

                                <div class="contact-map">
                                    <iframe
                                        src="https://www.openstreetmap.org/export/embed.html?bbox=72.48,22.98,72.52,23.01&amp;layer=mapnik&amp;marker=22.994176445653885,72.49916195582244"
                                        style="width:100%; height:100%; border:0;"
                                        allowfullscreen=""
                                        loading="lazy"/>
                                </div>

                                <ul class="contact-info-list">
                                    <li>
                                        <span class="contact-info-icon">
                                            <i class="fa fa-map-marker"/>
                                        </span>
                                        <div>
                                            <h4>Our Office</h4>
                                            <p>A-421 Siddhivinayak Towers, Makarba, Ahmedabad, Gujarat, India</p>
                                        </div>
                                    </li>
                                    <li>
                                        <span class="contact-info-icon">
                                            <i class="fa fa-envelope"/>
                                        </span>
                                        <div>
                                            <h4>Email</h4>
                                            <a href="mailto:contact@datainteger.com">contact@datainteger.com</a>
                                        </div>
                                    </li>
                                    <li>
                                        <span class="contact-info-icon">
                                            <i class="fa fa-phone"/>
                                        </span>
                                        <div>
                                            <h4>Phone</h4>
                                            <a href="tel:+919999999999">+91 99999 99999</a>
                                        </div>
                                    </li>
                                    <li>
                                        <span class="contact-info-icon">
                                            <i class="fa fa-clock-o" />
                                        </span>
                                        <div>
                                            <h4>Office Hours</h4>
                                            <p>Mon – Fri: 9:30 AM – 6:30 PM IST</p>
                                        </div>
                                    </li>
                                </ul>

                            </div>

                            <!-- Right: drag-and-drop zone for website builder -->
                            <div class="contact-form-card">
                                <div id="dics_contact_form_oe_structure" class="oe_structure oe_structure_solo"/>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>