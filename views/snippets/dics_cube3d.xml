<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="dics_cube3d" name="Datainteger Consultancy Services 3D Cube">
    <div class="dics-cube3d">
      <div class="dics-cube3d__core">
        <div class="dics-cube3d__face dics-cube3d__face--front"></div>
        <div class="dics-cube3d__face dics-cube3d__face--back"></div>
        <div class="dics-cube3d__face dics-cube3d__face--left"></div>
        <div class="dics-cube3d__face dics-cube3d__face--right"></div>
        <div class="dics-cube3d__face dics-cube3d__face--top"></div>
        <div class="dics-cube3d__face dics-cube3d__face--bottom"></div>
        <span class="dics-cube3d__corner dics-cube3d__corner--1"></span>
        <span class="dics-cube3d__corner dics-cube3d__corner--2"></span>
        <span class="dics-cube3d__corner dics-cube3d__corner--3"></span>
        <span class="dics-cube3d__corner dics-cube3d__corner--4"></span>
        <span class="dics-cube3d__corner dics-cube3d__corner--5"></span>
        <span class="dics-cube3d__corner dics-cube3d__corner--6"></span>
        <span class="dics-cube3d__corner dics-cube3d__corner--7"></span>
        <span class="dics-cube3d__corner dics-cube3d__corner--8"></span>
      </div>

      <div class="dics-cube3d__wheel">
        <t t-foreach="[
          ('layers', 'Odoo AI Agents'),
          ('message-circle', 'Odoo + WhatsApp'),
          ('workflow', 'Odoo AI Service'),
          ('sparkles', 'Odoo + Claude'),
          ('database', 'AI Powered Odoo ERP'),
          ('layout-dashboard', 'AI Integration'),
        ]" t-as="badge" t-key="badge_index">
          <div class="dics-badge-orbit" t-attf-style="--angle: #{badge_index * 60}deg;">
            <div class="dics-badge-orbit__counter">
              <div class="dics-badge-orbit__float" t-attf-style="animation-delay: #{badge_index * 0.4}s;">
                <span class="dics-badge-icon">
                  <t t-call="dics_theme.dics_icon"><t t-set="icon" t-value="badge[0]"/></t>
                </span>
                <span class="dics-badge-label" t-esc="badge[1]"/>
              </div>
            </div>
          </div>
        </t>
      </div>
    </div>
  </template>
</odoo>