<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Static/CSS+JS re-implementation of the React "CodeConsole" component:
    a glassmorphic core that tilts toward the cursor, sitting inside a
    slow auto-rotating typographic ring, with a couple of drifting
    accent particles. Pointer tracking lives in
    static/src/js/dics_console.js (mirrors the pattern already used
    by tilt_card.js).
  -->
  <template id="dics_console" name="Datainteger Consultancy Services Console Visual">
    <div class="dics-console" id="dics-console">
      <div class="dics-console__backlight"></div>

      <div class="dics-console__rig">
        <div class="dics-console__ring" aria-hidden="true">
          <svg viewBox="0 0 300 300">
            <path id="dicsConsoleTextPath"
                  d="M 150, 150 m -110, 0 a 110,110 0 1,1 220,0 a 110,110 0 1,1 -220,0"
                  fill="transparent"/>
            <text class="dics-console__ring-text">
              <textPath href="#dicsConsoleTextPath" startOffset="0%">
                • ODOO SAAS • MIGRATION • ODOO + WHATSAPP • DEPLOYEMENT • AUTOMATION • ODOO + CLAUDE
              </textPath>
            </text>
          </svg>
        </div>

        <div class="dics-console__crosshair" aria-hidden="true"></div>

        <div class="dics-console__glass" id="dics-console-glass">
          <div class="dics-console__glare"></div>
          <div class="dics-console__logo">
            <img src="/dics_theme_website/static/src/img/footer-logo.png" alt="Datainteger Consultancy Services"/>
          </div>
        </div>

        <span class="dics-console__particle dics-console__particle--a" id="dics-console-particle-a"></span>
        <span class="dics-console__particle dics-console__particle--b" id="dics-console-particle-b"></span>
      </div>
    </div>
  </template>
</odoo>