<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="dics_icon" name="Datainteger Consultancy Services Icon">
    <t t-if="icon == 'layers'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg"><polygon points="10,2 18,6.5 10,11 2,6.5"/><polyline points="2,10.5 10,15 18,10.5" class="dics-icon-stroke-only"/><polyline points="2,14.5 10,19 18,14.5" class="dics-icon-stroke-only"/></svg>
    </t>
    <t t-elif="icon == 'message-circle'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M2 10a8 8 0 1 1 3.6 6.7L2 18l1.2-3.7A7.96 7.96 0 0 1 2 10Z"/></svg>
    </t>
    <t t-elif="icon == 'workflow'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><rect x="2" y="2" width="6" height="6" rx="1.4"/><rect x="12" y="12" width="6" height="6" rx="1.4"/><path d="M5 8v3a2 2 0 0 0 2 2h3"/><path d="M15 12V9a2 2 0 0 0-2-2h-3"/></svg>
    </t>
    <t t-elif="icon == 'sparkles'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg"><path d="M9 2 10.4 6.6 15 8 10.4 9.4 9 14 7.6 9.4 3 8 7.6 6.6Z"/><path d="M16 12 16.7 14.3 19 15 16.7 15.7 16 18 15.3 15.7 13 15 15.3 14.3Z"/></svg>
    </t>
    <t t-elif="icon == 'database'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><ellipse cx="10" cy="5" rx="7" ry="2.6"/><path d="M3 5v10c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6V5"/><path d="M3 10c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6"/></svg>
    </t>
    <t t-elif="icon == 'layout-dashboard'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><rect x="2" y="2" width="8" height="7" rx="1.3"/><rect x="12" y="2" width="6" height="4" rx="1.3"/><rect x="12" y="8" width="6" height="10" rx="1.3"/><rect x="2" y="11" width="8" height="7" rx="1.3"/></svg>
    </t>
    <t t-elif="icon == 'brain-circuit'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M8 3a2.5 2.5 0 0 0-2.5 2.5v9A2.5 2.5 0 0 0 8 17"/><path d="M12 3a2.5 2.5 0 0 1 2.5 2.5v9A2.5 2.5 0 0 1 12 17"/><circle cx="5.5" cy="7" r="1"/><circle cx="14.5" cy="10" r="1"/><circle cx="5.5" cy="13" r="1"/><path d="M8 7h1.5M8 13h1.5M12 10h-1.5"/></svg>
    </t>
    <t t-elif="icon == 'code2'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><polyline points="7,5 2,10 7,15"/><polyline points="13,5 18,10 13,15"/></svg>
    </t>
    <t t-elif="icon == 'smartphone'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><rect x="5" y="1.5" width="10" height="17" rx="2"/><line x1="9" y1="15.3" x2="11" y2="15.3"/></svg>
    </t>
    <t t-elif="icon == 'line-chart'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><polyline points="2,18 2,2"/><polyline points="2,18 18,18"/><polyline points="4,13 8,9 11,11.5 17,5"/></svg>
    </t>
    <t t-elif="icon == 'cloud'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M5.5 15a3.8 3.8 0 0 1-.6-7.55A4.6 4.6 0 0 1 13.6 6a3.4 3.4 0 0 1 .9 6.68"/><path d="M5.5 15h9a2.6 2.6 0 0 0 0-5.2h-.1"/></svg>
    </t>
    <t t-elif="icon == 'search'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><circle cx="8.5" cy="8.5" r="6"/><line x1="13" y1="13" x2="18" y2="18"/></svg>
    </t>
    <t t-elif="icon == 'pen-tool'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M3 17 7 16 15 8 12 5 4 13Z"/><line x1="12" y1="5" x2="15" y2="8"/><line x1="3" y1="17" x2="3.7" y2="14.5"/></svg>
    </t>
    <t t-elif="icon == 'rocket'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M10 2c3 1.2 5 4.4 5 8 0 2-.6 3.6-1.4 4.8L10 18l-3.6-3.2C5.6 13.6 5 12 5 10c0-3.6 2-6.8 5-8Z"/><circle cx="10" cy="9" r="1.6"/><path d="M6 13.5 3.5 16M14 13.5 16.5 16"/></svg>
    </t>
    <t t-elif="icon == 'life-buoy'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><circle cx="10" cy="10" r="8"/><circle cx="10" cy="10" r="3.4"/><line x1="4.3" y1="4.3" x2="7.6" y2="7.6"/><line x1="12.4" y1="12.4" x2="15.7" y2="15.7"/><line x1="15.7" y1="4.3" x2="12.4" y2="7.6"/><line x1="7.6" y1="12.4" x2="4.3" y2="15.7"/></svg>
    </t>
    <t t-elif="icon == 'shield-check'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M10 2 17 4.5V9c0 5-3 7.8-7 9-4-1.2-7-4-7-9V4.5Z"/><polyline points="7,10 9.3,12.3 13.5,7.5"/></svg>
    </t>
    <t t-elif="icon == 'check-circle'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><circle cx="10" cy="10" r="8"/><polyline points="6.5,10.3 9,12.8 13.7,7.5"/></svg>
    </t>
    <t t-elif="icon == 'arrow-right'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><line x1="2" y1="10" x2="17" y2="10"/><polyline points="12,5 17,10 12,15"/></svg>
    </t>
    <t t-elif="icon == 'arrow-left'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline">
        <line x1="18" y1="10" x2="3" y2="10"/>
        <polyline points="8,5 3,10 8,15"/>
      </svg>
    </t>
    <t t-elif="icon == 'refresh-cw'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M16 6a6.4 6.4 0 0 0-11-3.2L3 5"/><polyline points="3,1.5 3,5 6.5,5"/><path d="M4 14a6.4 6.4 0 0 0 11 3.2L17 15"/><polyline points="17,18.5 17,15 13.5,15"/></svg>
    </t>
    <t t-elif="icon == 'target'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><circle cx="10" cy="10" r="7.5"/><circle cx="10" cy="10" r="4.3"/><circle cx="10" cy="10" r="1.1" class="dics-icon-svg"/></svg>
    </t>
    <t t-elif="icon == 'award'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><circle cx="10" cy="7.2" r="4.7"/><path d="M7.2 11.3 5.8 18l4.2-2.3L14.2 18l-1.4-6.7"/></svg>
    </t>
    <t t-elif="icon == 'credit-card'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><rect x="1.5" y="4" width="17" height="12" rx="1.6"/><line x1="1.5" y1="8" x2="18.5" y2="8"/><line x1="4" y1="12.3" x2="8" y2="12.3"/></svg>
    </t>
    <t t-elif="icon == 'package-check'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><path d="M2.5 6.2 10 2l7.5 4.2v7.6L10 18l-7.5-4.2Z"/><polyline points="2.5,6.2 10,10.3 17.5,6.2"/><line x1="10" y1="10.3" x2="10" y2="18"/><polyline points="7.6,4.1 13.6,7.5" class="dics-icon-stroke-only"/></svg>
    </t>
    <t t-elif="icon == 'mic'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><rect x="7.3" y="1.5" width="5.4" height="10" rx="2.7"/><path d="M4.2 9.3a5.8 5.8 0 0 0 11.6 0"/><line x1="10" y1="15.1" x2="10" y2="18.3"/><line x1="6.8" y1="18.3" x2="13.2" y2="18.3"/></svg>
    </t>
    <t t-elif="icon == 'bot'">
      <svg viewBox="0 0 20 20" class="dics-icon-svg dics-icon-outline"><rect x="3" y="6.5" width="14" height="10.5" rx="2.4"/><line x1="10" y1="3.2" x2="10" y2="6.5"/><circle cx="10" cy="2.2" r="1" class="dics-icon-svg"/><circle cx="7.2" cy="11.6" r="1.1" class="dics-icon-svg"/><circle cx="12.8" cy="11.6" r="1.1" class="dics-icon-svg"/><line x1="7" y1="15.2" x2="13" y2="15.2"/></svg>
    </t>
    <t t-elif="icon == 'briefcase'">
    <svg class="dics-icon-svg dics-icon-outline" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
        <line x1="12" y1="12" x2="12" y2="12"/>
        <path d="M2 12h20"/>
    </svg>
</t>
<t t-elif="icon == 'users'">
    <svg class="dics-icon-svg dics-icon-outline" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>
</t>
<t t-elif="icon == 'clock'">
    <svg class="dics-icon-svg dics-icon-outline" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
    </svg>
</t>
  </template>
</odoo>